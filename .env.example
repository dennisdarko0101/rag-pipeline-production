# Copy this file to .env and fill in your keys. Every value below has a
# sensible default in src/config/settings.py, so only the API keys are
# strictly required to run the pipeline.

# --- API keys (required) ---
ANTHROPIC_API_KEY=your-key-here
OPENAI_API_KEY=your-key-here

# --- Models ---
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_FALLBACK_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# --- Chunking ---
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# --- Retrieval ---
RETRIEVAL_TOP_K=10
RERANK_TOP_K=5

# --- Storage ---
CHROMA_PERSIST_DIR=./data/chroma

# --- API server ---
RATE_LIMIT_REQUESTS=60
LOG_LEVEL=INFO
